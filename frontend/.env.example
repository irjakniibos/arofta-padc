# Alamat backend Express (dipakai server Next.js untuk proxy & render halaman publik)
BACKEND_URL=http://localhost:5000
# Prefix API backend (harus sama dengan API_BASE_PATH di backend)
NEXT_PUBLIC_API_PREFIX=/api/v1
# Isi jika aplikasi dijalankan di subfolder, mis. /arofta (kosongkan jika di root domain)
NEXT_PUBLIC_BASE_PATH=
# Nama cookie login (harus sama dengan COOKIE_NAME di backend)
AUTH_COOKIE_NAME=arofta_token
# Opsional: alamat layanan tautan WhatsApp (default https://wa.me)
# NEXT_PUBLIC_WA_URL=https://wa.me
