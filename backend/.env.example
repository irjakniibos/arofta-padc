# ================= APLIKASI =================
NODE_ENV=development
PORT=5000
# Prefix semua endpoint. Contoh subfolder: /arofta/api/v1
API_BASE_PATH=/api/v1
# Origin frontend Next.js (pisahkan dengan koma jika lebih dari satu)
CORS_ORIGIN=http://localhost:3000
# URL frontend, dipakai untuk link di email (reset password, dll)
FRONTEND_URL=http://localhost:3000
# Jumlah proxy di depan backend. Isi 1 bila diakses lewat frontend Next.js (proxy /api),
# agar rate limit membaca IP asli pengguna. 0 hanya jika backend diakses langsung.
TRUST_PROXY=1

# ================= DATABASE (MySQL) =================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=arofta_padc
DB_USER=arofta_app
DB_PASSWORD=
DB_TIMEZONE=+07:00
# Database khusus pengujian otomatis (npm test)
DB_NAME_TEST=arofta_padc_test

# ================= AUTENTIKASI =================
# Wajib diisi string acak panjang (min 32 karakter). Contoh membuat:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
COOKIE_NAME=arofta_token
# lax (frontend & backend satu domain) | none (beda domain, wajib HTTPS)
COOKIE_SAMESITE=lax
# true jika memakai HTTPS (wajib di production)
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
# Batas request API per IP per 15 menit
API_RATE_LIMIT=1500
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RESET_TOKEN_MINUTES=30

# ================= LOGIN DENGAN GOOGLE =================
# Google Cloud Console > Google Auth Platform > Clients > OAuth client ID (Web application).
# Authorized redirect URI: <FRONTEND_URL><API_BASE_PATH>/auth/google/callback
#   contoh lokal: http://localhost:3000/api/v1/auth/google/callback
# Kosongkan GOOGLE_CLIENT_ID untuk menyembunyikan tombol Masuk dengan Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=   (opsional, bila berbeda dari pola di atas)

# ================= EMAIL (SMTP) =================
# Kosongkan SMTP_HOST untuk mode development: email (termasuk link reset password) dicetak di terminal.
# Contoh Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=alamat@gmail.com,
# SMTP_PASSWORD="App Password 16 huruf" (Akun Google > Keamanan > Verifikasi 2 langkah > Sandi aplikasi)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="AROFTA PADC <no-reply@arofta.id>"

# ================= FILE & LAPORAN =================
STORAGE_PATH=./storage
UPLOAD_MAX_SIZE_MB=2
# Perintah LibreOffice untuk konversi DOCX -> PDF.
# Kosongkan jika server tidak punya LibreOffice (laporan dikirim dalam .docx)
SOFFICE_PATH=soffice
REPORT_CITY=Surakarta

# ================= JOB TERJADWAL =================
ENABLE_CRON=true

# ================= SEEDER =================
SEED_SUPERADMIN_EMAIL=superadmin@arofta.id
SEED_SUPERADMIN_PASSWORD=
# Isi true hanya di lokal/development untuk membuat data contoh
SEED_DUMMY_DATA=false
